<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Conq.Noble.Spreadox</RootNamespace>
    <AssemblyName>Conq.Noble.Spreadox</AssemblyName>
    <AssemblyTitle>Spreadox</AssemblyTitle>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <IsPackable>true</IsPackable>
    <PackageId>Spreadox</PackageId>
    <Title>Spreadox</Title>
    <Description>Spreadox is a high-performance, dependency-isolated C# library for native Excel (.xlsx) workbooks and vector A4 landscape PDF chart reports. Features memory-efficient SAX streaming for millions of rows and native OpenXML DrawingML charts.</Description>
    <PackageTags>spreadox;excel;xlsx;spreadsheet;openxml;pdf;report;chart;charts;streaming;ooxml;vector;csharp;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/FatihBaycu/Spreadox/releases</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Conq.Noble.Spreadox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
  </ItemGroup>

</Project>
